/// One row per month, January 1969 to September 2026.
table Date
	lineageTag: f9939738-692f-436b-9809-ee2892a75f53

	column Month
		dataType: dateTime
		isKey
		formatString: mmm yyyy
		lineageTag: 7542ca18-8e4a-4ea8-bdba-63b8eb3345a2
		summarizeBy: none
		sourceColumn: Month

	column Year
		dataType: int64
		lineageTag: 952bacd7-a8b8-4065-97ba-a80d53331ab8
		summarizeBy: none
		sourceColumn: Year

	column 'Month No'
		dataType: int64
		isHidden
		lineageTag: 4202ecb4-5578-4c54-bef3-68d5ffb5219e
		summarizeBy: none
		sourceColumn: Month No

	column 'Month Name'
		dataType: string
		lineageTag: 55f3e83f-c1ea-4a55-a094-a5a4a3b33474
		summarizeBy: none
		sourceColumn: Month Name
		sortByColumn: 'Month No'

	column 'Year Month'
		dataType: string
		lineageTag: 75e3ccfc-f639-4a7e-8b31-5755f44661ae
		summarizeBy: none
		sourceColumn: Year Month

	column Decade
		dataType: string
		lineageTag: 76737fcc-d4a7-4d27-b363-095af3135256
		summarizeBy: none
		sourceColumn: Decade

	/// Inflation targeting was adopted in February 2000.
	column Era
		dataType: string
		lineageTag: c8fe45ac-3b49-4923-a21f-a29a95eb7731
		summarizeBy: none
		sourceColumn: Era

	partition Date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "calendar.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Renamed = Table.RenameColumns(Promoted, {{"month", "Month"}, {"year", "Year"}, {"month_no", "Month No"}, {"month_name", "Month Name"}, {"year_month", "Year Month"}, {"decade", "Decade"}, {"era", "Era"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Month", type date}, {"Year", Int64.Type}, {"Month No", Int64.Type}, {"Month Name", type text}, {"Year Month", type text}, {"Decade", type text}, {"Era", type text}}, "en-US")
				in
				    Typed

