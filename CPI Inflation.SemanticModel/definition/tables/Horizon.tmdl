/// How many months ahead a forecast was made.
table Horizon
	lineageTag: aaa80965-deeb-40e4-8cfb-fbf06ad6946e

	column Horizon
		dataType: int64
		isHidden
		lineageTag: 098e22c9-c0fd-44e8-8167-a75cee8877f1
		summarizeBy: none
		sourceColumn: Horizon

	column 'Months Ahead'
		dataType: string
		lineageTag: eb2bc34d-7d9c-458c-a4ed-1760d7a92f52
		summarizeBy: none
		sourceColumn: Months Ahead
		sortByColumn: Horizon

	partition Horizon = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "horizon.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Renamed = Table.RenameColumns(Promoted, {{"horizon", "Horizon"}, {"horizon_label", "Months Ahead"}}),
				    Typed = Table.TransformColumnTypes(Renamed, {{"Horizon", Int64.Type}, {"Months Ahead", type text}})
				in
				    Typed

