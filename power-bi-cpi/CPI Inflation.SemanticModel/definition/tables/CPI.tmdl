/// Stats SA headline CPI, one row per month: the official year-on-year rate (from 1969) and the index, Dec 2024 = 100 (from 1980).
table CPI
	lineageTag: a52c0e7f-fcdf-4afd-9b5b-ebf760503421

	/// Stats SA's official year-on-year rate. Over more than one month, the average of the monthly rates.
	measure 'Official Rate' = AVERAGE ( CPI[Monthly Rate] )
		formatString: 0.0"%"
		displayFolder: 1 Inflation
		lineageTag: 5985bfbd-e7b8-475a-98c2-2f1885ca5429

	/// Year-on-year inflation worked out from the index: this month's index over the index 12 months earlier. One month at a time; from January 1981.
	measure 'Rate from Index' =
			VAR _month = MAX ( 'Date'[Month] )
			VAR _now = CALCULATE ( SUM ( CPI[Index] ), REMOVEFILTERS ( 'Date' ), 'Date'[Month] = _month )
			VAR _yearAgo = CALCULATE ( SUM ( CPI[Index] ), REMOVEFILTERS ( 'Date' ), 'Date'[Month] = EDATE ( _month, -12 ) )
			RETURN
			    IF ( HASONEVALUE ( 'Date'[Month] ) && _now > 0 && _yearAgo > 0, ( DIVIDE ( _now, _yearAgo ) - 1 ) * 100 )
		formatString: 0.0"%"
		displayFolder: 1 Inflation
		lineageTag: fd5a911d-6687-43de-922c-77829f4abb17

	/// Rate from the index minus the official rate. Small, because Stats SA rounds the published index.
	measure 'Index Check Gap (pts)' = IF ( NOT ISBLANK ( [Rate from Index] ), [Rate from Index] - [Official Rate] )
		formatString: 0.00
		displayFolder: 1 Inflation
		lineageTag: 88d29cd0-a9f7-4906-b33a-68458a4eaa7d

	/// Average official rate over the 12 months to the last month in view. Written by hand because the date table is monthly.
	measure 'Official Rate 12m Average' =
			VAR _month = MAX ( 'Date'[Month] )
			RETURN
			    CALCULATE (
			        AVERAGE ( CPI[Monthly Rate] ),
			        REMOVEFILTERS ( 'Date' ),
			        'Date'[Month] > EDATE ( _month, -12 ),
			        'Date'[Month] <= _month
			    )
		formatString: 0.0"%"
		displayFolder: 1 Inflation
		lineageTag: 65f4be0d-9d27-4d39-b588-04c3d590138c

	/// Highest official rate in the period.
	measure 'Peak Rate' = MAX ( CPI[Monthly Rate] )
		formatString: 0.0"%"
		displayFolder: 1 Inflation
		lineageTag: 8ec44785-3df5-4fb6-94d5-6aa3c3c2185e

	/// The latest month in the period with the highest official rate.
	measure 'Peak Month' =
			VAR _peak = [Peak Rate]
			RETURN
			    MAXX ( FILTER ( CPI, CPI[Monthly Rate] = _peak ), CPI[Month] )
		formatString: mmm yyyy
		displayFolder: 1 Inflation
		lineageTag: 073bf88e-6c8d-4e29-9cdc-5843dc776537

	/// The official rate in the last month of the period.
	measure 'Latest Rate' =
			VAR _last = MAX ( CPI[Month] )
			RETURN
			    CALCULATE ( AVERAGE ( CPI[Monthly Rate] ), REMOVEFILTERS ( 'Date' ), 'Date'[Month] = _last )
		formatString: 0.0"%"
		displayFolder: 1 Inflation
		lineageTag: 7df174e8-d557-4f43-b2fc-545542e35da7

	/// Months in the period with official inflation above 10%.
	measure 'Months Above 10%' = COUNTROWS ( FILTER ( CPI, CPI[Monthly Rate] > 10 ) )
		formatString: #,0
		displayFolder: 1 Inflation
		lineageTag: ff7f31d3-c41b-42a8-a0b5-9447809b8528

	column Month
		dataType: dateTime
		isHidden
		formatString: yyyy-mm
		lineageTag: 79966b87-60c1-405c-b5d2-112e0cb7f9c5
		summarizeBy: none
		sourceColumn: Month

	/// Headline CPI, Dec 2024 = 100. Blank before 1980.
	column Index
		dataType: double
		isHidden
		lineageTag: bd978792-a794-42b2-adc9-058c7f3c3521
		summarizeBy: none
		sourceColumn: Index

	/// Stats SA's official year-on-year rate, in percent.
	column 'Monthly Rate'
		dataType: double
		isHidden
		lineageTag: 8c923cd8-d2b9-4d3e-a45f-fcf297ebccc2
		summarizeBy: none
		sourceColumn: Monthly Rate

	partition CPI = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "cpi_headline.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"index_dec2024_100"}),
				    Renamed = Table.RenameColumns(Blanks, {{"month", "Month"}, {"index_dec2024_100", "Index"}, {"yoy_rate_pct", "Monthly Rate"}}),
				    WithDate = Table.TransformColumns(Renamed, {{"Month", each Date.FromText(_ & "-01"), type date}}),
				    Typed = Table.TransformColumnTypes(WithDate, {{"Index", type number}, {"Monthly Rate", type number}}, "en-US")
				in
				    Typed

